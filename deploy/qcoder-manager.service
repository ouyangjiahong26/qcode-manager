[Unit]
Description=QCoder Manager (Qoder 账号池管理面板 · OpenAI 兼容网关)
After=network.target
# 上游 qoder2api 是独立服务，本面板不管理它的生命周期；若上游也是 systemd
# 服务（例如 qoder2api.service），可在此追加 After=/Wants= 保证启动顺序。

[Service]
Type=simple
WorkingDirectory=/opt/qcoder-manager
# 以专用账号运行（install.sh 创建）。面板持有全部 PAT 凭据，是攻击面最大的
# 常驻进程，不能以 root 跑。
User=qcode
Group=qcode
Environment=QC_MANAGER_HOST=127.0.0.1
Environment=QC_MANAGER_PORT=7865
Environment=QC2API_BASE=http://127.0.0.1:8963
Environment=QC_DATA_DIR=/opt/qcoder-manager/data
Environment=QC_STATIC_DIR=/opt/qcoder-manager/web/out
Environment=QC_SECURE_COOKIE=auto
# 真实 IP 取自反代覆盖写入的 X-Real-IP；nginx 与服务同机，可信代理网段只放
# 回环（前置 CDN 时把 QC_TRUSTED_PROXY_HOPS 改成 CDN+反代层数）
Environment=QC_TRUST_PROXY=1
Environment=QC_TRUSTED_PROXY_CIDRS=127.0.0.1
# 生产环境不暴露 /docs、/openapi.json（调试时改 1）
Environment=QC_ENABLE_DOCS=0
# 每密钥每分钟调用上限（0 = 不限）
Environment=QC_GATEWAY_RATE_PER_MIN=120
# 首次启动若不设 QC_ADMIN_PASSWORD，会随机生成并打印到日志（journalctl 可见）
# Environment=QC_ADMIN_PASSWORD=改成你的强密码
# 其余可选项（QC_HTTP_PROXY、QC_UPDATE_PROXY 等）写进安装目录的 .env——由下面
# 这行读入；`-` 表示文件不存在时不报错。
# 注意：EnvironmentFile 的值是字面量，别在值后面写行内注释。
EnvironmentFile=-/opt/qcoder-manager/.env

# 为什么默认只监听回环：公网访问必须走反向代理（HTTPS + 访问控制），直接
# 暴露 7865 时登录锁定与 IP 管控的可信度都取决于转发头。
ExecStart=/opt/qcoder-manager/venv/bin/python -m uvicorn server.main:app --host 127.0.0.1 --port 7865
Restart=always
RestartSec=3

# ── 沙箱（最小权限）──────────────────────────────────────
# 服务只需读写自己的 data/ 与监听端口。NoNewPrivileges：进程树内不能再提权；
# ProtectSystem=full：/usr /boot /etc 只读（应用目录在 /opt，不受影响）。
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
