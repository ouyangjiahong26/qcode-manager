# ===== qcoder-manager 配置（复制为 .env 后按需修改；未列出的项见 server/config.py）=====

# 面板监听。公网部署请保持 127.0.0.1 并由反向代理（nginx/Caddy）暴露，
# 反代需透传 X-Real-IP / X-Forwarded-For 才能让 IP 白名单拿到真实来源
QC_MANAGER_HOST=127.0.0.1
QC_MANAGER_PORT=7865

# 上游 qoder2api 基址（同机部署时保持仅本机监听）
QC2API_BASE=http://127.0.0.1:8963

# 数据目录（SQLite、users.json、secret.key 都在这里，注意备份与权限）
QC_DATA_DIR=./data

# 首次启动的管理员密码；留空则生成随机密码并打印在日志与
# data/initial-admin-password.txt（首次登录后建议改密）
QC_ADMIN_PASSWORD=

# 会话
QC_SESSION_DAYS=1
QC_SESSION_IDLE_HOURS=12

# 网关
QC_GATEWAY_RATE_PER_MIN=120
QC_GATEWAY_MAX_BODY_MB=32

# 出站代理（面板访问上游时一般不需要；qoder2api 出站走它自己的配置）
QC_HTTP_PROXY=

# 是否暴露 /docs（Swagger）
QC_ENABLE_DOCS=0

# 一键更新（可选）
QC_GITHUB_TOKEN=
QC_GITHUB_MIRROR=
QC_UPDATE_PROXY=

# 构建加速（docker compose build 读取）：pip 默认清华源；npm 默认官方源、
# 失败自动降级 npmmirror，需要时填 NPM_REGISTRY=https://registry.npmmirror.com
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
NPM_REGISTRY=
